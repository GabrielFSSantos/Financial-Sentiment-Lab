# ==============================================================================
# MODELO PÚBLICO DE CONFIGURAÇÃO DO SANTOS DUMONT
# ==============================================================================
#
# Arquivo consumido pelos scripts:
#
#   scripts/sync_to_scratch.sh
#   scripts/setup_sdumont_env.sh
#   scripts/submit_sdumont.sh
#   scripts/download_sdumont_results.sh
#
# Este arquivo pode ser versionado e serve como referência pública.
# Para criar a configuração privada:
#
#   cp configs/sdumont.env.example configs/sdumont.env
#   chmod 600 configs/sdumont.env
#
# Depois, preencha somente configs/sdumont.env. Não coloque credenciais,
# nomes de usuário, hosts privados, contas de projeto ou caminhos pessoais
# neste arquivo de exemplo.
#
# Regras:
#
# - utilize somente atribuições Bash no formato NOME="valor";
# - não utilize espaços ao redor do sinal de igualdade;
# - mantenha caminhos absolutos quando o comentário solicitar;
# - valores vazios representam opções não configuradas;
# - modelos, datasets e parâmetros de inferência NÃO pertencem a este arquivo;
# - a seleção científica continua em configs/models.yaml,
#   configs/datasets.yaml e configs/experiment.yaml.
#
# Depois de copiar e preencher o arquivo privado:
#
#   chmod 600 configs/sdumont.env
#
# Validação posterior:
#
#   ./scripts/run_experiment.sh \
#       --environment sdumont \
#       --print-only
# ==============================================================================


# ==============================================================================
# VERSÃO DA CONFIGURAÇÃO
# ==============================================================================

SDUMONT_CONFIG_SCHEMA_VERSION="2.0"


# ==============================================================================
# ACESSO SSH — CAMPOS OBRIGATÓRIOS
# ==============================================================================
#
# Mantenha os seis campos abaixo vazios neste arquivo público.
# Preencha-os apenas na cópia privada configs/sdumont.env antes da primeira
# execução no SDumont.
#
# USERNAME
#   Nome de usuário utilizado no acesso remoto.
#
# LOGIN_HOST
#   Host de login disponibilizado para sua conta.
#
# ACCOUNT
#   Conta/projeto de contabilização utilizado pelo Slurm.
#
# PARTITION
#   Partição Slurm autorizada para o experimento.
#
# SCRATCH_DIR
#   Diretório absoluto do usuário ou projeto no Scratch.
#
# PYTHON_MODULE
#   Módulo Python disponível no ambiente do SDumont.
#
# Os scripts considerarão a configuração incompleta enquanto qualquer um
# desses valores estiver vazio.

USERNAME=""
LOGIN_HOST=""
ACCOUNT=""
PARTITION=""
SCRATCH_DIR=""
PYTHON_MODULE=""


# ==============================================================================
# ACESSO SSH — OPÇÕES
# ==============================================================================

SSH_PORT="22"

# Caminho local absoluto para a chave SSH.
# Vazio utiliza a seleção padrão do cliente SSH ou ssh-agent.
SSH_IDENTITY_FILE=""

# Host alternativo para ProxyJump.
# Vazio desativa ProxyJump.
SSH_PROXY_JUMP=""

# Arquivo local conhecido pelos scripts para controle persistente da conexão.
# Vazio faz os scripts criarem um caminho dentro de .tmp/sdumont/.
SSH_CONTROL_PATH=""

# Tempo máximo para estabelecer a conexão.
SSH_CONNECT_TIMEOUT_SECONDS="20"

# Mantém conexões longas ativas.
SSH_SERVER_ALIVE_INTERVAL_SECONDS="30"
SSH_SERVER_ALIVE_COUNT_MAX="3"

# true exige autenticação não interativa.
# Em false, o SSH poderá solicitar senha ou confirmação no terminal.
SSH_BATCH_MODE="true"

# Verificação da chave do host:
#
#   yes         exige que o host já esteja em known_hosts;
#   accept-new  aceita hosts novos, mas rejeita alterações;
#   no          desativa a verificação, não recomendado.
SSH_STRICT_HOST_KEY_CHECKING="accept-new"

# Arquivo known_hosts alternativo.
# Vazio utiliza ~/.ssh/known_hosts.
SSH_KNOWN_HOSTS_FILE=""

# Opções adicionais literais do SSH.
# Exemplo:
#
# SSH_EXTRA_OPTIONS="-o Compression=yes"
#
# Evite inserir dados secretos.
SSH_EXTRA_OPTIONS=""


# ==============================================================================
# DIRETÓRIOS REMOTOS
# ==============================================================================

# Nome da pasta do projeto dentro do Scratch.
REMOTE_PROJECT_NAME="financial-sentiment-lab"

# Caminho absoluto da cópia remota do projeto.
#
# Quando vazio:
#
#   ${SCRATCH_DIR}/${REMOTE_PROJECT_NAME}
REMOTE_PROJECT_DIR=""

# Ambiente virtual remoto.
#
# Quando vazio:
#
#   ${SCRATCH_DIR}/.venvs/${REMOTE_PROJECT_NAME}
REMOTE_VENV_DIR=""

# Cache do Pip.
#
# Quando vazio:
#
#   ${SCRATCH_DIR}/.cache/pip
REMOTE_PIP_CACHE_DIR=""

# Cache do Hugging Face/Transformers.
#
# Quando vazio:
#
#   ${SCRATCH_DIR}/.cache/huggingface
REMOTE_HF_HOME=""

# Diretório remoto que recebe os resultados da pipeline.
#
# Quando vazio:
#
#   ${REMOTE_PROJECT_DIR}/outputs
REMOTE_OUTPUT_DIR=""

# Diretório remoto dos logs gerais e do Slurm.
#
# Quando vazio:
#
#   ${REMOTE_PROJECT_DIR}/logs
REMOTE_LOG_DIR=""

# Diretório temporário remoto.
#
# Quando vazio:
#
#   ${REMOTE_PROJECT_DIR}/.tmp
REMOTE_TEMP_DIR=""


# ==============================================================================
# MÓDULOS DO AMBIENTE REMOTO
# ==============================================================================

# true executa "module purge" antes de carregar os módulos configurados.
MODULE_PURGE="true"

# Módulo CUDA compatível com o PyTorch selecionado.
# Vazio deixa a configuração dependente do módulo Python ou do ambiente base.
CUDA_MODULE=""

# Outros módulos separados por espaço.
#
# Exemplo:
#
# ADDITIONAL_MODULES="gcc/versao cmake/versao"
ADDITIONAL_MODULES=""

# Comando usado para gerenciar módulos.
MODULE_COMMAND="module"


# ==============================================================================
# AMBIENTE PYTHON REMOTO
# ==============================================================================

REMOTE_REQUIREMENTS_FILE="requirements.txt"

# Atualiza pip, setuptools e wheel antes de instalar requirements.txt.
REMOTE_UPGRADE_PACKAGING_TOOLS="true"

# Reinstala requirements.txt mesmo quando o arquivo de controle indicar que o
# ambiente já está atualizado.
REMOTE_FORCE_INSTALL="false"

# Remove e recria o ambiente virtual remoto.
REMOTE_RECREATE_VENV="false"

# Índices opcionais do Pip.
# Vazio mantém a configuração padrão do ambiente.
PIP_INDEX_URL=""
PIP_EXTRA_INDEX_URL=""

# true desativa o cache do Pip.
PIP_NO_CACHE_DIR="false"

# Argumentos adicionais literais enviados a pip install.
#
# Exemplo:
#
# PIP_INSTALL_EXTRA_ARGS="--prefer-binary"
PIP_INSTALL_EXTRA_ARGS=""

# Evita tentativas de download durante a inferência.
TRANSFORMERS_OFFLINE="1"
HF_HUB_OFFLINE="1"
HF_HUB_DISABLE_TELEMETRY="1"
TOKENIZERS_PARALLELISM="false"


# ==============================================================================
# RECURSOS DO JOB SLURM
# ==============================================================================
#
# Estes valores são usados por scripts/submit_sdumont.sh ao chamar sbatch.
# Não são mantidos dentro do arquivo .srm para permitir alteração por
# configuração sem editar o job.

SLURM_JOB_NAME="financial-sentiment"

SLURM_TIME="01:00:00"
SLURM_NODES="1"
SLURM_NTASKS="1"
SLURM_CPUS_PER_TASK="4"

# Quantidade de GPUs solicitadas.
# Use 0 somente para uma execução explicitamente em CPU.
SLURM_GPUS="1"

# Tipo/modelo de GPU, quando a partição exigir.
# Vazio solicita somente a quantidade.
SLURM_GPU_TYPE=""

# Memória total do job.
SLURM_MEM="32G"

# Opções opcionais da instalação.
SLURM_QOS=""
SLURM_CONSTRAINT=""
SLURM_RESERVATION=""

# true adiciona --exclusive.
SLURM_EXCLUSIVE="false"

# Dependência Slurm opcional.
# Exemplo:
#
# SLURM_DEPENDENCY="afterok:123456"
SLURM_DEPENDENCY=""

# Notificações por e-mail.
#
# Exemplos de SLURM_MAIL_TYPE:
#   NONE
#   END
#   FAIL
#   END,FAIL
SLURM_MAIL_TYPE="NONE"
SLURM_MAIL_USER=""

# Exportação adicional de variáveis pelo Slurm.
# Os scripts já exportarão as variáveis necessárias à pipeline.
SLURM_EXPORT_EXTRA=""

# Opções adicionais literais do sbatch.
#
# Exemplo:
#
# SLURM_ADDITIONAL_OPTIONS="--hint=nomultithread"
SLURM_ADDITIONAL_OPTIONS=""

# Comandos Slurm, alteráveis para ambientes que usem wrappers.
SBATCH_COMMAND="sbatch"
SQUEUE_COMMAND="squeue"
SACCT_COMMAND="sacct"
SCONTROL_COMMAND="scontrol"
SCANCEL_COMMAND="scancel"


# ==============================================================================
# ARQUIVOS DE LOG DO SLURM
# ==============================================================================

# Padrões relativos a REMOTE_LOG_DIR.
#
# %x = nome do job
# %j = ID do job
SLURM_STDOUT_PATTERN="slurm/%x-%j.out"
SLURM_STDERR_PATTERN="slurm/%x-%j.err"

# Quantidade de linhas exibidas pelo monitor quando o job falhar.
SLURM_FAILURE_LOG_LINES="200"


# ==============================================================================
# SINCRONIZAÇÃO LOCAL → SCRATCH
# ==============================================================================

RSYNC_COMMAND="rsync"

# true remove do destino remoto arquivos que deixaram de existir localmente.
# Mantenha false durante os primeiros testes.
SYNC_DELETE="false"

# true sincroniza model_store/.
SYNC_MODEL_STORE="true"

# true sincroniza datasets/raw/ e datasets/processed/.
SYNC_DATASETS="true"

# Normalmente outputs e logs são produzidos remotamente e não devem ser
# enviados do computador local.
SYNC_OUTPUTS="false"
SYNC_LOGS="false"

# Preserva arquivos parcialmente transferidos para permitir retomada.
SYNC_PARTIAL="true"

# Comprime a transferência SSH.
SYNC_COMPRESS="true"

# Exibe progresso durante a sincronização.
SYNC_PROGRESS="true"

# Checksum é mais rigoroso, mas pode tornar a sincronização muito mais lenta.
SYNC_CHECKSUM="false"

# Limite de banda em KiB/s.
# 0 significa sem limite.
SYNC_BWLIMIT_KBPS="0"

# Exclusões adicionais separadas por vírgula.
#
# As exclusões internas dos scripts já contemplarão:
#
#   .git
#   venv
#   .venv
#   __pycache__
#   *.pyc
#   .pytest_cache
#   .mypy_cache
#   .ruff_cache
#   .tmp
#   configs/sdumont.env
#
# Exemplo:
#
# SYNC_EXTRA_EXCLUDES="documentacao_privada,dados_temporarios"
SYNC_EXTRA_EXCLUDES=""


# ==============================================================================
# MONITORAMENTO DO JOB
# ==============================================================================

# Intervalo entre consultas ao Slurm.
MONITOR_INTERVAL_SECONDS="30"

# Tempo máximo de monitoramento.
# 0 aguarda indefinidamente.
MONITOR_TIMEOUT_SECONDS="0"

# Tempo adicional após o job desaparecer do squeue antes de consultar sacct.
MONITOR_ACCOUNTING_GRACE_SECONDS="15"

# Número de tentativas para obter o estado final pelo sacct.
MONITOR_ACCOUNTING_RETRIES="10"

# Intervalo entre tentativas do sacct.
MONITOR_ACCOUNTING_RETRY_SECONDS="10"

# true cancela o job quando o monitor local recebe SIGINT ou SIGTERM.
MONITOR_CANCEL_JOB_ON_SIGNAL="false"


# ==============================================================================
# DOWNLOAD DOS RESULTADOS
# ==============================================================================

# Diretórios locais relativos à raiz do projeto.
LOCAL_OUTPUT_DIR="outputs"
LOCAL_LOG_DIR="logs"

DOWNLOAD_OUTPUTS="true"
DOWNLOAD_LOGS="true"

# true usa --delete no rsync de download.
# Mantenha false para não remover resultados locais anteriores.
DOWNLOAD_DELETE="false"

DOWNLOAD_PARTIAL="true"
DOWNLOAD_COMPRESS="true"
DOWNLOAD_PROGRESS="true"
DOWNLOAD_CHECKSUM="false"

# Sobrescreve arquivos locais mais novos.
DOWNLOAD_OVERWRITE_NEWER="false"

# Exclusões adicionais separadas por vírgula.
DOWNLOAD_EXTRA_EXCLUDES=""

# true mantém os resultados no Scratch após o download.
KEEP_REMOTE_RESULTS="true"


# ==============================================================================
# SEGURANÇA E VALIDAÇÃO
# ==============================================================================

# Exige que SCRATCH_DIR e caminhos derivados sejam absolutos.
REQUIRE_ABSOLUTE_REMOTE_PATHS="true"

# Impede operações remotas destrutivas quando o destino não estiver abaixo de
# SCRATCH_DIR.
REQUIRE_REMOTE_PATH_UNDER_SCRATCH="true"

# true confirma que o projeto remoto possui pipeline/runner.py antes de
# preparar ou submeter.
VALIDATE_REMOTE_PROJECT="true"

# true confirma a presença dos arquivos obrigatórios do modelo no Scratch.
VALIDATE_REMOTE_MODEL_FILES="true"

# true confirma a presença dos datasets selecionados no Scratch.
VALIDATE_REMOTE_DATASET_FILES="true"

# true executa uma importação das dependências após preparar o venv remoto.
VALIDATE_REMOTE_PYTHON_IMPORTS="true"


# ==============================================================================
# COMANDOS DE TRANSFERÊNCIA
# ==============================================================================

SSH_COMMAND="ssh"
SCP_COMMAND="scp"

# shell utilizado nos comandos remotos.
REMOTE_SHELL="bash"


# ==============================================================================
# OBSERVAÇÕES
# ==============================================================================
#
# Este arquivo não deve conter:
#
# - MODEL_KEYS;
# - DATASET_KEYS;
# - batch_size;
# - max_length;
# - device do modelo;
# - caminhos de modelos individuais;
# - caminhos de datasets individuais;
# - parâmetros de classificação ou agregação.
#
# Essas informações já têm fontes únicas:
#
# - configs/models.yaml;
# - configs/datasets.yaml;
# - configs/experiment.yaml.
# ==============================================================================
