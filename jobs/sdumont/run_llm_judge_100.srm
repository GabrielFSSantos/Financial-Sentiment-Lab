#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --partition=sequana_gpu_dev
#SBATCH --job-name=llm_judge_100
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=job_llm_judge_100_%j.out
#SBATCH --error=job_llm_judge_100_%j.out

SCRATCH_BASE="${SCRATCH:-/scratch/ufsj/hpc4agents-br/gabriel.santos3}"
WORKING_DIR="${SCRATCH_BASE}/financial-sentiment-lab"

cd "${WORKING_DIR}" || exit 1
printf 'Início LLM-judge 100: %s\n' "$(date -Iseconds)"

module purge
module load cuda/12.6_sequana
module load anaconda3/2024.02_sequana

source venv/bin/activate
export LLM_JUDGE_MOCK=0

bash "${WORKING_DIR}/scripts/campaigns/run_llm_judge_100_gpu.sh"

printf 'Fim LLM-judge 100: %s\n' "$(date -Iseconds)"
