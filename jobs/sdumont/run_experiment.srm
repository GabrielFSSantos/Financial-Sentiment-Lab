#!/bin/bash

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=sequana_gpu_dev
#SBATCH --job-name=financial
#SBATCH --cpus-per-task=30
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=00:20:00
#SBATCH --output=job_financial_%j.out
#SBATCH --error=job_financial_%j.err


SCRATCH_BASE="${SCRATCH:-/scratch/ufsj/hpc4agents-br/gabriel.santos3}"
WORKING_DIR="${SCRATCH_BASE}/financial-sentiment-lab"

cd "${WORKING_DIR}" || exit 1

printf 'Início do job: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
printf 'Job Slurm: %s\n' "${SLURM_JOB_ID:-desconhecido}"
printf 'Diretório: %s\n' "${WORKING_DIR}"
printf 'Saída do Slurm: %s/job_financial_%s.out\n' \
    "${WORKING_DIR}" "${SLURM_JOB_ID:-JOB_ID}"
printf 'Logs da pipeline: %s/logs/<run_id>.log\n' "${WORKING_DIR}"
printf 'Progresso por combinação modelo×dataset aparece abaixo.\n'


printf 'Nó de execução: '
scontrol show hostnames "${SLURM_NODELIST}"


module purge
module load arch_gpu/current
module load cuda/12.6
module load anaconda3/2024.02_sequana


source venv/bin/activate

srun ./scripts/run_experiment.sh \
    --environment sdumont \
    --skip-setup
