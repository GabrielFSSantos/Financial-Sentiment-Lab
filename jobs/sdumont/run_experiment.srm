#!/usr/bin/env bash

# ==============================================================================
# JOB SLURM ÚNICO PARA EXECUÇÃO DOS EXPERIMENTOS
# ==============================================================================
#
# Submetido por:
#
#   scripts/submit_sdumont.sh
#
# Recursos como conta, partição, tempo, memória, CPUs, GPUs e arquivos de log
# são passados dinamicamente ao sbatch. Por isso, este arquivo não possui
# diretivas #SBATCH de infraestrutura.
#
# Todos os argumentos recebidos são encaminhados para:
#
#   scripts/run_service.sh
#
# O pipeline.runner executa, dentro deste único job, todos os pares:
#
#   modelos selecionados × datasets selecionados
#
# Não são utilizados arrays Slurm.
# ==============================================================================

set -Eeuo pipefail
IFS=$'\n\t'
umask 027


# ==============================================================================
# CONSTANTES E ESTADO
# ==============================================================================

readonly JOB_SCRIPT_NAME="run_experiment.srm"
readonly MINIMUM_PYTHON_MAJOR=3
readonly MINIMUM_PYTHON_MINOR=10

RUNNER_ARGUMENTS=("$@")

CHILD_PID=""
JOB_STARTED_AT_EPOCH="$(date +%s)"
JOB_STARTED_AT_UTC="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
JOB_FINISHED_AT_UTC=""
JOB_EXIT_CODE=""
JOB_FINAL_STATUS="INITIALIZING"
JOB_MESSAGE="Inicializando o job."
JOB_STATE_FILE=""

PROJECT_DIR=""
VENV_DIR_RESOLVED=""
OUTPUT_DIR=""
LOG_DIR=""
TEMP_DIR=""
PYTHON_EXECUTABLE=""


# ==============================================================================
# LOG
# ==============================================================================

timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}


log() {
    local message=""
    printf -v message '%s' "$@"

    printf '[%s] [%s] %s\n' \
        "$(timestamp)" \
        "${JOB_SCRIPT_NAME}" \
        "${message}"
}


warning() {
    local message=""
    printf -v message '%s' "$@"

    printf '[%s] [%s] AVISO: %s\n' \
        "$(timestamp)" \
        "${JOB_SCRIPT_NAME}" \
        "${message}" \
        >&2
}


error() {
    local message=""
    printf -v message '%s' "$@"

    printf '[%s] [%s] ERRO: %s\n' \
        "$(timestamp)" \
        "${JOB_SCRIPT_NAME}" \
        "${message}" \
        >&2
}


die() {
    JOB_FINAL_STATUS="FAILED"
    JOB_MESSAGE="$*"
    error "$*"
    exit 1
}


print_command() {
    printf '[%s] [%s] Comando:' \
        "$(timestamp)" \
        "${JOB_SCRIPT_NAME}"

    printf ' %q' "$@"
    printf '\n'
}


# ==============================================================================
# AUXILIARES
# ==============================================================================

normalize_lowercase() {
    printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]'
}


is_true() {
    local value=""

    value="$(normalize_lowercase "${1:-false}")"

    case "${value}" in
        1|true|yes|y|on|sim|s)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


require_non_empty() {
    local value="$1"
    local field_name="$2"

    [[ -n "${value}" ]] || die \
        "Variável obrigatória ausente: ${field_name}"
}


require_file() {
    local path="$1"
    local description="$2"

    [[ -f "${path}" ]] || die \
        "${description} não encontrado: ${path}"

    [[ -r "${path}" ]] || die \
        "${description} sem permissão de leitura: ${path}"
}


require_directory() {
    local path="$1"
    local description="$2"

    [[ -d "${path}" ]] || die \
        "${description} não encontrado: ${path}"

    [[ -r "${path}" ]] || die \
        "${description} sem permissão de leitura: ${path}"
}


require_executable() {
    local path="$1"
    local description="$2"

    [[ -x "${path}" ]] || die \
        "${description} não é executável: ${path}"
}


validate_runner_arguments() {
    local argument=""

    for argument in "${RUNNER_ARGUMENTS[@]}"; do
        [[ "${argument}" != *$'\n'* ]] || die \
            "Um argumento do runner contém quebra de linha."

        [[ "${argument}" != *$'\r'* ]] || die \
            "Um argumento do runner contém retorno de carro."
    done
}


validate_python_version() {
    local python_executable="$1"

    "${python_executable}" - \
        "${MINIMUM_PYTHON_MAJOR}" \
        "${MINIMUM_PYTHON_MINOR}" \
        <<'PYTHON_VERSION_CHECK'
from __future__ import annotations

import sys

minimum = (int(sys.argv[1]), int(sys.argv[2]))
current = sys.version_info[:2]

if current < minimum:
    raise SystemExit(
        "Python incompatível. "
        f"Mínimo: {minimum[0]}.{minimum[1]}. "
        f"Encontrado: {sys.version.split()[0]}"
    )
PYTHON_VERSION_CHECK
}


initialize_modules() {
    if type module >/dev/null 2>&1; then
        return 0
    fi

    for initialization_file in \
        /etc/profile.d/modules.sh \
        /usr/share/Modules/init/bash \
        /etc/profile.d/lmod.sh \
        /usr/share/lmod/lmod/init/bash
    do
        if [[ -r "${initialization_file}" ]]; then
            # shellcheck disable=SC1090
            source "${initialization_file}"

            if type module >/dev/null 2>&1; then
                return 0
            fi
        fi
    done

    if [[ -r /etc/profile ]]; then
        set +u
        # shellcheck disable=SC1091
        source /etc/profile >/dev/null 2>&1 || true
        set -u
    fi

    if [[ "${MODULE_COMMAND}" == "module" ]]; then
        type module >/dev/null 2>&1 || die \
            "O comando module não está disponível no nó de execução."
    else
        command -v "${MODULE_COMMAND}" >/dev/null 2>&1 || die \
            "Comando de módulos não encontrado: ${MODULE_COMMAND}"
    fi
}


load_modules() {
    local additional_modules=()
    local module_name=""

    initialize_modules

    if is_true "${MODULE_PURGE}"; then
        log "Limpando os módulos carregados."
        "${MODULE_COMMAND}" purge
    fi

    log "Carregando módulo Python: ${PYTHON_MODULE}"
    "${MODULE_COMMAND}" load "${PYTHON_MODULE}"

    if [[ -n "${CUDA_MODULE}" ]]; then
        log "Carregando módulo CUDA: ${CUDA_MODULE}"
        "${MODULE_COMMAND}" load "${CUDA_MODULE}"
    fi

    if [[ -n "${ADDITIONAL_MODULES}" ]]; then
        read -r -a additional_modules <<< "${ADDITIONAL_MODULES}"

        for module_name in "${additional_modules[@]}"; do
            [[ -n "${module_name}" ]] || continue
            log "Carregando módulo adicional: ${module_name}"
            "${MODULE_COMMAND}" load "${module_name}"
        done
    fi

    if type module >/dev/null 2>&1; then
        log "Módulos ativos:"
        module list 2>&1 || true
    elif [[ "${MODULE_COMMAND}" != "true" ]]; then
        "${MODULE_COMMAND}" list 2>&1 || true
    fi
}


write_job_state() {
    local temporary_file=""
    local now_epoch=""
    local duration_seconds=""
    local runner_arguments_text=""

    [[ -n "${JOB_STATE_FILE}" ]] || return 0

    now_epoch="$(date +%s)"
    duration_seconds=$((now_epoch - JOB_STARTED_AT_EPOCH))
    printf -v runner_arguments_text '%q ' "${RUNNER_ARGUMENTS[@]}"

    mkdir -p -- "$(dirname -- "${JOB_STATE_FILE}")"

    temporary_file="$(
        mktemp \
            "$(dirname -- "${JOB_STATE_FILE}")/.job-state.XXXXXX"
    )"

    {
        printf '# Gerado por jobs/sdumont/run_experiment.srm\n'
        printf 'STATE_SCHEMA_VERSION=%q\n' "2.0"
        printf 'JOB_ID=%q\n' "${SLURM_JOB_ID:-}"
        printf 'JOB_NAME=%q\n' "${SLURM_JOB_NAME:-}"
        printf 'STATUS=%q\n' "${JOB_FINAL_STATUS}"
        printf 'EXIT_CODE=%q\n' "${JOB_EXIT_CODE}"
        printf 'STARTED_AT=%q\n' "${JOB_STARTED_AT_UTC}"
        printf 'FINISHED_AT=%q\n' "${JOB_FINISHED_AT_UTC}"
        printf 'DURATION_SECONDS=%q\n' "${duration_seconds}"
        printf 'HOSTNAME=%q\n' "$(hostname 2>/dev/null || printf desconhecido)"
        printf 'NODELIST=%q\n' "${SLURM_NODELIST:-}"
        printf 'PROJECT_DIR=%q\n' "${PROJECT_DIR}"
        printf 'VENV_DIR=%q\n' "${VENV_DIR_RESOLVED}"
        printf 'OUTPUT_DIR=%q\n' "${OUTPUT_DIR}"
        printf 'LOG_DIR=%q\n' "${LOG_DIR}"
        printf 'RUNNER_ARGUMENTS=%q\n' "${runner_arguments_text}"
        printf 'MESSAGE=%q\n' "${JOB_MESSAGE}"
    } > "${temporary_file}"

    chmod 600 "${temporary_file}"
    mv -f -- "${temporary_file}" "${JOB_STATE_FILE}"
}


runtime_report() {
    "${PYTHON_EXECUTABLE}" - <<'PYTHON_RUNTIME_REPORT'
from __future__ import annotations

import os
import platform
import socket
import sys

print("=== Runtime Python ===")
print(f"Hostname: {socket.gethostname()}")
print(f"Python: {platform.python_version()}")
print(f"Executável: {sys.executable}")
print(f"Diretório atual: {os.getcwd()}")
print(f"PYTHONPATH: {os.environ.get('PYTHONPATH', '')}")
print(f"CUDA_VISIBLE_DEVICES: {os.environ.get('CUDA_VISIBLE_DEVICES', '')}")

try:
    import torch
except Exception as error:
    print(f"PyTorch indisponível: {type(error).__name__}: {error}")
else:
    print(f"PyTorch: {torch.__version__}")
    print(f"CUDA do PyTorch: {torch.version.cuda}")
    print(f"CUDA disponível: {torch.cuda.is_available()}")

    if torch.cuda.is_available():
        print(f"GPUs visíveis: {torch.cuda.device_count()}")

        for index in range(torch.cuda.device_count()):
            print(f"GPU {index}: {torch.cuda.get_device_name(index)}")
PYTHON_RUNTIME_REPORT
}


print_slurm_report() {
    log "Informações do Slurm:"
    printf '  Job ID: %s\n' "${SLURM_JOB_ID:-não informado}"
    printf '  Nome: %s\n' "${SLURM_JOB_NAME:-não informado}"
    printf '  Conta: %s\n' \
        "${SLURM_JOB_ACCOUNT:-${SLURM_ACCOUNT:-não informado}}"
    printf '  Partição: %s\n' \
        "${SLURM_JOB_PARTITION:-não informado}"
    printf '  Nós: %s\n' "${SLURM_NNODES:-não informado}"
    printf '  NodeList: %s\n' "${SLURM_NODELIST:-não informado}"
    printf '  Tarefas: %s\n' "${SLURM_NTASKS:-não informado}"
    printf '  CPUs/tarefa: %s\n' \
        "${SLURM_CPUS_PER_TASK:-não informado}"
    printf '  GPUs: %s\n' \
        "${SLURM_JOB_GPUS:-${SLURM_GPUS:-${CUDA_VISIBLE_DEVICES:-não informado}}}"
    printf '  Diretório de submissão: %s\n' \
        "${SLURM_SUBMIT_DIR:-não informado}"
}


# ==============================================================================
# ERROS, SINAIS E SAÍDA
# ==============================================================================

on_error() {
    local exit_code=$?
    local line_number="${BASH_LINENO[0]:-desconhecida}"
    local failed_command="${BASH_COMMAND:-desconhecido}"

    trap - ERR

    JOB_FINAL_STATUS="FAILED"
    JOB_EXIT_CODE="${exit_code}"
    JOB_FINISHED_AT_UTC="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    JOB_MESSAGE="Falha na linha ${line_number}: ${failed_command}"

    error "O job foi interrompido por uma falha."
    error "Código de saída: ${exit_code}"
    error "Linha aproximada: ${line_number}"
    error "Comando: ${failed_command}"

    write_job_state
    exit "${exit_code}"
}


on_signal() {
    local signal_name="$1"
    local exit_code=143

    trap - INT TERM HUP

    case "${signal_name}" in
        INT)
            exit_code=130
            ;;
        TERM)
            exit_code=143
            ;;
        HUP)
            exit_code=129
            ;;
    esac

    warning "Sinal ${signal_name} recebido."

    if [[ -n "${CHILD_PID}" ]] && \
        kill -0 "${CHILD_PID}" 2>/dev/null
    then
        warning \
            "Encaminhando ${signal_name} à pipeline " \
            "(PID ${CHILD_PID})."

        kill "-${signal_name}" "${CHILD_PID}" 2>/dev/null || true

        set +e
        wait "${CHILD_PID}"
        set -e

        CHILD_PID=""
    fi

    JOB_FINAL_STATUS="INTERRUPTED"
    JOB_EXIT_CODE="${exit_code}"
    JOB_FINISHED_AT_UTC="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    JOB_MESSAGE="Job interrompido pelo sinal ${signal_name}."

    write_job_state
    exit "${exit_code}"
}


on_exit() {
    local exit_code=$?

    if [[ -z "${JOB_EXIT_CODE}" ]]; then
        JOB_EXIT_CODE="${exit_code}"
    fi

    if [[ -z "${JOB_FINISHED_AT_UTC}" ]]; then
        JOB_FINISHED_AT_UTC="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi

    if [[ "${JOB_FINAL_STATUS}" == "RUNNING" ]]; then
        if [[ "${exit_code}" -eq 0 ]]; then
            JOB_FINAL_STATUS="COMPLETED"
            JOB_MESSAGE="Pipeline concluída com sucesso."
        else
            JOB_FINAL_STATUS="FAILED"
            JOB_MESSAGE="Pipeline terminou com código ${exit_code}."
        fi
    fi

    write_job_state
}


trap on_error ERR
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM
trap 'on_signal HUP' HUP
trap on_exit EXIT


# ==============================================================================
# VARIÁVEIS RECEBIDAS DO SUBMIT
# ==============================================================================

PROJECT_DIR="${FINANCIAL_SENTIMENT_PROJECT_DIR:-${SLURM_SUBMIT_DIR:-}}"
VENV_DIR_RESOLVED="${FINANCIAL_SENTIMENT_VENV_DIR:-${VENV_DIR:-}}"
OUTPUT_DIR="${FINANCIAL_SENTIMENT_OUTPUT_DIR:-}"
LOG_DIR="${FINANCIAL_SENTIMENT_LOG_DIR:-}"
TEMP_DIR="${FINANCIAL_SENTIMENT_TEMP_DIR:-}"

PYTHON_MODULE="${PYTHON_MODULE:-}"
CUDA_MODULE="${CUDA_MODULE:-}"
ADDITIONAL_MODULES="${ADDITIONAL_MODULES:-}"
MODULE_PURGE="${MODULE_PURGE:-true}"
MODULE_COMMAND="${MODULE_COMMAND:-module}"

TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
HF_HUB_DISABLE_TELEMETRY="${HF_HUB_DISABLE_TELEMETRY:-1}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

require_non_empty "${PROJECT_DIR}" \
    "FINANCIAL_SENTIMENT_PROJECT_DIR"
require_non_empty "${VENV_DIR_RESOLVED}" \
    "FINANCIAL_SENTIMENT_VENV_DIR"
require_non_empty "${PYTHON_MODULE}" \
    "PYTHON_MODULE"

if [[ -z "${OUTPUT_DIR}" ]]; then
    OUTPUT_DIR="${PROJECT_DIR%/}/outputs"
fi

if [[ -z "${LOG_DIR}" ]]; then
    LOG_DIR="${PROJECT_DIR%/}/logs"
fi

if [[ -z "${TEMP_DIR}" ]]; then
    TEMP_DIR="${PROJECT_DIR%/}/.tmp"
fi

JOB_STATE_FILE="${FINANCIAL_SENTIMENT_JOB_STATE_FILE:-${TEMP_DIR%/}/jobs/${SLURM_JOB_ID:-manual}.env}"

RUN_SERVICE_SCRIPT="${PROJECT_DIR%/}/scripts/run_service.sh"
PIPELINE_RUNNER="${PROJECT_DIR%/}/pipeline/runner.py"
REQUIREMENTS_FILE_PATH="${PROJECT_DIR%/}/requirements.txt"

validate_runner_arguments


# ==============================================================================
# PREPARAÇÃO DO NÓ DE EXECUÇÃO
# ==============================================================================

require_directory "${PROJECT_DIR}" \
    "Diretório do projeto remoto"
require_file "${PIPELINE_RUNNER}" \
    "Runner da pipeline"
require_file "${REQUIREMENTS_FILE_PATH}" \
    "Arquivo de dependências"
require_file "${RUN_SERVICE_SCRIPT}" \
    "Serviço de execução"
require_executable "${RUN_SERVICE_SCRIPT}" \
    "Serviço de execução"

mkdir -p -- \
    "${OUTPUT_DIR}" \
    "${LOG_DIR}" \
    "${TEMP_DIR}" \
    "$(dirname -- "${JOB_STATE_FILE}")"

cd "${PROJECT_DIR}"

load_modules

PYTHON_EXECUTABLE="${PYTHON_BIN:-${VENV_DIR_RESOLVED%/}/bin/python}"

require_executable \
    "${PYTHON_EXECUTABLE}" \
    "Python do ambiente virtual remoto"

validate_python_version "${PYTHON_EXECUTABLE}"

export FINANCIAL_SENTIMENT_PROJECT_DIR="${PROJECT_DIR}"
export FINANCIAL_SENTIMENT_VENV_DIR="${VENV_DIR_RESOLVED}"
export FINANCIAL_SENTIMENT_OUTPUT_DIR="${OUTPUT_DIR}"
export FINANCIAL_SENTIMENT_LOG_DIR="${LOG_DIR}"
export FINANCIAL_SENTIMENT_TEMP_DIR="${TEMP_DIR}"

export EXECUTION_ENVIRONMENT="sdumont"
export VENV_DIR="${VENV_DIR_RESOLVED}"
export PYTHON_BIN="${PYTHON_EXECUTABLE}"
export PYTHONPATH="${PROJECT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"

export HF_HOME="${HF_HOME:-${TEMP_DIR%/}/huggingface}"
export TRANSFORMERS_OFFLINE
export HF_HUB_OFFLINE
export HF_HUB_DISABLE_TELEMETRY
export TOKENIZERS_PARALLELISM

DEFAULT_THREADS="${SLURM_CPUS_PER_TASK:-1}"

if [[ ! "${DEFAULT_THREADS}" =~ ^[1-9][0-9]*$ ]]; then
    warning \
        "SLURM_CPUS_PER_TASK inválido: ${DEFAULT_THREADS}. Usando 1."
    DEFAULT_THREADS="1"
fi

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-${DEFAULT_THREADS}}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-${DEFAULT_THREADS}}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-${DEFAULT_THREADS}}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-${DEFAULT_THREADS}}"

mkdir -p -- "${HF_HOME}"


# ==============================================================================
# RELATÓRIO INICIAL
# ==============================================================================

JOB_FINAL_STATUS="RUNNING"
JOB_MESSAGE="Pipeline em execução."
write_job_state

log "Job iniciado em ${JOB_STARTED_AT_UTC}."
log "Projeto remoto: ${PROJECT_DIR}"
log "Ambiente virtual: ${VENV_DIR_RESOLVED}"
log "Python: ${PYTHON_EXECUTABLE}"
log "Outputs: ${OUTPUT_DIR}"
log "Logs: ${LOG_DIR}"
log "Temporários: ${TEMP_DIR}"
log "Estado do job: ${JOB_STATE_FILE}"

print_slurm_report
runtime_report

if (( ${#RUNNER_ARGUMENTS[@]} > 0 )); then
    log "Argumentos recebidos:"
    printf '  '
    printf '%q ' "${RUNNER_ARGUMENTS[@]}"
    printf '\n'
else
    log \
        "Nenhum argumento adicional foi recebido; " \
        "modelos e datasets serão resolvidos pelos YAMLs."
fi


# ==============================================================================
# EXECUÇÃO DA PIPELINE
# ==============================================================================

RUN_COMMAND=(
    "${RUN_SERVICE_SCRIPT}"
    "${RUNNER_ARGUMENTS[@]}"
)

print_command "${RUN_COMMAND[@]}"

set +e

"${RUN_COMMAND[@]}" &
CHILD_PID=$!

wait "${CHILD_PID}"
PIPELINE_EXIT_CODE=$?

CHILD_PID=""

set -e

JOB_EXIT_CODE="${PIPELINE_EXIT_CODE}"
JOB_FINISHED_AT_UTC="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

if [[ "${PIPELINE_EXIT_CODE}" -eq 0 ]]; then
    JOB_FINAL_STATUS="COMPLETED"
    JOB_MESSAGE="Pipeline concluída com sucesso."
    log "Pipeline concluída com sucesso."
else
    JOB_FINAL_STATUS="FAILED"
    JOB_MESSAGE="Pipeline terminou com código ${PIPELINE_EXIT_CODE}."
    error "A pipeline terminou com código ${PIPELINE_EXIT_CODE}."
fi

write_job_state

JOB_FINISHED_AT_EPOCH="$(date +%s)"
JOB_DURATION_SECONDS=$((JOB_FINISHED_AT_EPOCH - JOB_STARTED_AT_EPOCH))

log \
    "Job finalizado em ${JOB_FINISHED_AT_UTC} após " \
    "${JOB_DURATION_SECONDS} segundo(s)."

exit "${PIPELINE_EXIT_CODE}"
