#!/bin/bash

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=sequana_gpu_dev
#SBATCH --job-name=financial
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=00:20:00
#SBATCH --output=job_financial_%j.out
#SBATCH --error=job_financial_%j.err


# Diretório do projeto no Scratch
WORKING_DIR="/scratch/ufsj/hpc4agents-br/iago.oliveira3/financial-sentiment-lab"

cd "${WORKING_DIR}" || exit 1


# Mostra o nó utilizado
scontrol show hostnames "${SLURM_NODELIST}"


# Carrega os módulos do ambiente
module purge
module load cuda/12.6_sequana
module load anaconda3/2024.02_sequana


# Ativa o ambiente virtual já preparado
source venv/bin/activate


# Executa o experimento
srun ./scripts/run_experiment.sh \
    --environment sdumont \
    --skip-setup