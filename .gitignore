# ==============================================================================
# CONFIGURAÇÃO PRIVADA DO SANTOS DUMONT
# ==============================================================================

configs/sdumont.env

# O modelo público precisa permanecer versionado.
!configs/sdumont.env.example


# ==============================================================================
# ARQUIVOS TEMPORÁRIOS E ESTADO DE EXECUÇÃO
# ==============================================================================

.tmp/
tmp/
temp/

*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

*.pid
*.pid.lock
*.lock

# Arquivos de estado criados pelos scripts do SDumont.
submission*.env
job-state*.env


# ==============================================================================
# LOGS
# ==============================================================================

logs/
*.log

slurm-*.out
slurm-*.err
*.out
*.err

# Permite preservar o diretório no repositório, caso exista.
!logs/.gitkeep


# ==============================================================================
# RESULTADOS DA PIPELINE
# ==============================================================================

outputs/

# Permite preservar o diretório vazio no repositório, caso exista.
!outputs/.gitkeep


# ==============================================================================
# MODELOS E PESOS
# ==============================================================================

model_store/

# Arquivos leves de documentação podem ser versionados.
!model_store/.gitkeep
!model_store/README.md

# Pesos e artefatos comuns de modelos.
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.pb
*.tflite

# Arquivos grandes de tokenizadores/modelos gerados localmente.
tokenizer.json
special_tokens_map.json
tokenizer_config.json
added_tokens.json
generation_config.json


# ==============================================================================
# DATASETS
# ==============================================================================

# Dados processados são sempre regeneráveis.
datasets/processed/

# Mantém arquivos de marcação/documentação, caso existam.
!datasets/processed/.gitkeep
!datasets/processed/README.md

# Por padrão, dados brutos não são versionados.
datasets/raw/**

# Mantém a estrutura e o dataset pequeno usado nos testes locais.
!datasets/raw/.gitkeep
!datasets/raw/README.md
!datasets/raw/noticias_exemplo/
!datasets/raw/noticias_exemplo/noticias.csv
!datasets/raw/noticias_exemplo/README.md

# Formatos frequentemente grandes.
*.parquet
*.feather
*.arrow
*.orc
*.avro

*.sqlite
*.sqlite3
*.db

*.npy
*.npz
*.pkl
*.pickle
*.joblib


