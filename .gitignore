# ==============================================================================
# FINANCIAL SENTIMENT LAB
# ==============================================================================
#
# Regras gerais:
#
# - arquivos de código, configuração pública e documentação são versionados;
# - credenciais e configurações privadas nunca são versionadas;
# - ambientes Python, caches, logs, resultados e arquivos temporários ficam
#   somente no ambiente local ou no Scratch;
# - pesos de modelos e datasets grandes não são enviados ao Git;
# - o dataset de exemplo permanece versionado para permitir testes locais.
# ==============================================================================


# ==============================================================================
# SISTEMA OPERACIONAL
# ==============================================================================

.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100/
.Trashes/
.fseventsd/

Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/


